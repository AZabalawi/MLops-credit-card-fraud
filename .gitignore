# DVC-tracked data artifacts (regenerated via `dvc repro`)
/data/processed

# Raw data is version-tracked by DVC (data/raw/creditcard.csv.dvc is committed);
# the large CSV itself is kept out of git.
/data/raw/creditcard.csv

# Models: the served artifact IS committed, because Render builds the Docker
# image straight from this repository and the image has to contain the model.
# Everything else in models/ is a local by-product of retraining.
/models/*
!/models/model.pkl

# MLflow local tracking store (regenerated when experiments are run)
mlruns/
mlflow.db
mlartifacts/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Secrets - the Render deploy hook lives in GitHub Actions secrets, never here
.env
.env.*
*.pem
*.key

# OS / editor cruft
.DS_Store
.vscode/
.idea/

# DVC cache
/.dvc/cache
/.dvc/tmp

# Reports generated at runtime
/reports/*.png
/reports/*.txt
